# ===================================================================
# Python
# ===================================================================

# 虚拟环境 (Virtual Environments)
# 忽略整个 venv 目录
/venv/
/env/
.env
.venv

# Python 缓存文件 (Bytecode and cache)
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook 检查点
.ipynb_checkpoints

# ===================================================================
# C/C++ / Build Artifacts
# ===================================================================

# 编译产物 (Compiled files and build outputs)
# 忽略所有 .pyd, .dll, .def 文件
*.pyd
*.dll
*.def
*.so
*.a
*.lib
*.obj
*.o

# 构建目录 (Build directories)
/build/
/out/
/x64/
/Debug/
/Release/

# ===================================================================
# IDE & Editor Specific
# ===================================================================

# Visual Studio / VS Code
.vs/
.vscode/
*.sln
*.suo
*.user
*.vcxproj
*.vcxproj.filters

# ===================================================================
# Data, Models & Caches
# ===================================================================

# 模型和数据缓存 (Model and data caches)
# 通常模型文件和缓存很大，不应纳入版本控制
/model_cache/
/kws_models/

# 数据库文件 (Database)
# 忽略 db 目录
/db/

# 配置文件 (Configurations)
# 如果 configs.json 目录中包含敏感信息或本地特定配置，则应忽略
/configs.json/

# ===================================================================
# General / OS
# ===================================================================

# 备份文件 (Backup files)
*.bak
*.swp
*~

# 操作系统生成的文件 (OS generated files)
.DS_Store
Thumbs.db

# 第三方库 (Vendor libraries)
# 如果 vendor 目录是通过 vcpkg 或其他包管理器自动生成的，建议忽略
# 如果是您手动存放的必要库，可以从下面这行移除
/vendor/